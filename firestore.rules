rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Restrict access to user's own document and subcollections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow user creation without setting arbitrary usedStorageBytes
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['usedStorageBytes']) || request.resource.data.usedStorageBytes == 0);
      
      // Client cannot manually tamper with usedStorageBytes (maintained securely by Cloud Functions)
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['usedStorageBytes']));
      
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow users to submit feedback and surveys
    match /bug_reports/{document=**} {
      allow create: if true;
    }
    match /feature_requests/{document=**} {
      allow create: if true;
    }
    match /surveys/{document=**} {
      allow create: if true;
    }
  }
}
