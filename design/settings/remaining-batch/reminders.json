  "screens": [
    {
      "key": "reminders",
      "title": "Reminders",
      "subtitle": "Bring overlooked notes and links back into view.",
      "blocks": [
        {
          "type": "group",
          "label": "Review reminders",
          "rows": [
            {
              "title": "Use reminders",
              "sub": "Resurface notes and links you haven’t opened recently.",
              "on": true,
              "icon": "reminder",
              "target": "reminders_off"
            }
          ]
        },
        {
          "type": "group",
          "label": "Schedule",
          "rows": [
            {
              "title": "Delivery time",
              "sub": "Local time · Android may deliver later",
              "icon": "clock",
              "target": "reminders_time",
              "value": "9:00 AM"
            },
            {
              "title": "Minimum inactivity",
              "sub": "Consider items unopened for at least this long",
              "icon": "history",
              "target": "reminders_inactivity",
              "value": "7 days"
            }
          ]
        },
        {
          "type": "group",
          "label": "Preferences",
          "rows": [
            {
              "title": "Prioritize active folders",
              "sub": "Favor overlooked notes in folders you worked in recently.",
              "on": true,
              "icon": "folder"
            },
            {
              "title": "Include weekends",
              "sub": "Allow reminders on Saturdays and Sundays.",
              "on": false,
              "icon": "reminder"
            }
          ]
        },
        {
          "type": "group",
          "label": "Check & reset",
          "rows": [
            {
              "title": "Send test reminder",
              "sub": "Send a sample notification now",
              "icon": "reminder",
              "target": "reminders"
            },
            {
              "title": "Reset learning history",
              "sub": "Clear local review activity and response history",
              "icon": "history",
              "target": "reminders_reset"
            }
          ]
        },
        {
          "type": "group",
          "label": "Movies & shows",
          "rows": [
            {
              "title": "Screening picks",
              "sub": "Recommendations and optional morning questions",
              "icon": "movie",
              "target": "screening_picks"
            }
          ]
        }
      ],
      "theme": "Dark",
      "caption": "Reminders · Dark",
      "back": "settings"
    },
