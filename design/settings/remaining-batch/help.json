  "questions": [
    {
      "key": "capture",
      "category": "getting_started",
      "title": "How do I save content?",
      "answer": "Open the capture menu to create a note or recording. To save content from another app, choose Cobalt in Android’s Share menu. Enable Side dock for screen-edge capture."
    },
    {
      "key": "organize",
      "category": "getting_started",
      "title": "How are saved items organized?",
      "answer": "Category views separate notes, links, images, video, audio, code and media. Folders group saved items across those categories. You can give folders a color and pin the ones you use often."
    },
    {
      "key": "dock",
      "category": "getting_started",
      "title": "How does Side dock work?",
      "answer": "Enable Side dock and allow display over other apps. Swipe inward from its screen-edge handle to open capture tools and recent items. Handle controls and animation settings are in Side dock settings."
    },
    {
      "key": "ocr",
      "category": "gemini",
      "title": "How does screen OCR use Gemini?",
      "answer": "Cobalt sends the selected image region to Gemini to extract text. This needs an internet connection and a saved Gemini API key. Review the extracted text, especially when the image is blurry or low contrast."
    },
