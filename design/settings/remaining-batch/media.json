{
  "name": "Media & providers",
  "description": "Search sources, account connection, outgoing changes and precise setup or recovery states.",
  "sources": [
    "MediaSettingsScreen.kt",
    "TraktSyncSettingsScreen.kt",
    "PendingTraktChangesScreen.kt",
    "MovieApiKeyScreen.kt"
  ],
  "screens": [
    {
      "key": "media",
      "title": "Media & providers",
      "subtitle": "Search sources, metadata and account sync.",
      "blocks": [
        {
          "type": "group",
          "label": "Connections",
          "rows": [
            {
              "title": "Trakt account & sync",
              "sub": "Watch history, watchlist and personal ratings",
              "icon": "trakt",
              "target": "trakt",
              "value": "Connected"
            },
            {
              "title": "TMDB API key",
              "sub": "Posters, trailers and movie or TV details",
              "icon": "key",
              "target": "tmdb",
              "value": "Key saved"
            }
          ]
        },
        {
          "type": "group",
          "label": "Search sources",
          "rows": [
            {
              "title": "Trakt",
              "sub": "Movies and TV · Uses your connected account",
              "on": true,
              "icon": "trakt"
            },
            {
              "title": "TMDB",
              "sub": "Movies and TV · Uses your API key",
              "on": true,
              "icon": "movie"
            },
            {
              "title": "Jikan",
              "sub": "Anime and manga · No account required",
              "on": true,
              "icon": "reading"
            }
          ]
        },
        {
          "type": "group",
          "label": "Metadata",
          "rows": [
            {
              "title": "Metadata priority",
              "sub": "Source used first when both find a title",
              "icon": "movie",
              "target": "media_priority",
              "value": "Trakt first"
            }
          ]
        },
        {
          "type": "group",
          "label": "Anime & manga",
          "rows": [
            {
              "title": "Include manga",
              "sub": "Save chapter, volume and publication details.",
              "on": true,
              "icon": "reading"
            },
            {
              "title": "Jikan server",
              "sub": "Public server or your own Jikan v4 instance",
              "icon": "globe",
              "target": "jikan",
              "value": "Public"
            }
          ]
        },
        {
          "type": "group",
          "label": "Sync & local archive",
          "rows": [
            {
              "title": "Pending Trakt changes",
              "sub": "Queued changes, paused categories and retries",
              "icon": "sync",
              "target": "trakt_pending",
              "value": "3 pending"
            },
            {
              "title": "Ignored deleted titles",
              "sub": "Prevent locally deleted titles from returning",
              "icon": "trash",
              "target": "media_ignored_reset",
              "value": "4 titles"
            }
          ]
        }
      ],
      "theme": "Dark",
      "caption": "Media & providers · Dark",
      "back": "settings"
    },
